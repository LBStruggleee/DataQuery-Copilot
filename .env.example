# DeepSeek API Key (https://platform.deepseek.com 注册获取)
DEEPSEEK_API_KEY=your_api_key_here

# 模型名称
MODEL_NAME=deepseek-chat

# 数据库路径
DB_PATH=data/query.db

# Web API 默认查询的数据表
TABLE_NAME=orders

# 允许访问 Web API 的前端地址（多个地址用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据文件路径
DATA_FILE=data/sample_ecommerce.csv

# 结构化 JSON 日志（生产镜像默认开启；本地按需开启）
# DQC_JSON_LOGS=1

# 关闭 /docs、/redoc、/openapi.json（生产镜像与 Render Blueprint 默认开启此开关）
# DQC_DISABLE_DOCS=1
